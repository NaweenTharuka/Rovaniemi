# Database: SQLite file for local/single-server, or a postgres:// URL for production
DATABASE_URL=file:./heading-north.db
# Long random string (openssl rand -hex 32). Required in production.
PAYLOAD_SECRET=
# Public origin of the site, no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Shared secret for draft previews from the admin
PREVIEW_SECRET=

# Optional: enquiry notification email (without SMTP, emails are logged to the console)
ENQUIRY_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=HEADING NORTH website

# Optional analytics overrides (otherwise managed in Site Settings)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
